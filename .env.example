# Kinwise environment. Copy to .env and fill in real values.
# Never commit the filled-in file.

# Tiger Data / PostgreSQL. Tiger Cloud is PostgreSQL-compatible.
# Use the service URL from Tiger Console. asyncpg accepts ssl=require.
# Example:
# DATABASE_URL=postgresql+asyncpg://tsdbadmin:PASSWORD@HOST:5432/tsdb?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kinwise

# HS256 signing secret for short-lived access tokens. Use a long random value.
JWT_SECRET=replace-with-a-long-random-string

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# development | test | production
ENVIRONMENT=development

# Google Gemini. One generateContent call per eligible child message.
# https://ai.google.dev/gemini-api/docs/generate-content/structured-output
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Backboard persistent memory. https://docs.backboard.io
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Spectrum iMessage bridge. This is the dashboard project, not a Photon OAuth app.
# Project id is the UUID from the Spectrum getting-started page. The secret is
# on that same page. Do not commit the secret.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_BRIDGE_TOKEN=replace-with-a-long-random-string
SPECTRUM_BRIDGE_URL=http://127.0.0.1:8787
SPECTRUM_BRIDGE_PORT=8787
KINWISE_API_URL=http://127.0.0.1:8000

# Daily child message cap enforced before any Gemini call.
DAILY_MESSAGE_LIMIT=200
